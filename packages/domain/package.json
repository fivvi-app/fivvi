{
  "name": "@fivvi/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/payments/testing/index.ts"
  },
  "scripts": {
    "lint": "biome check --formatter-enabled=false --error-on-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format:check": "biome format .",
    "generate:privacy": "node scripts/generate-privacy.ts",
    "import:dry-run": "node --env-file-if-exists=../database/.env src/import/cli.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@fivvi/i18n": "workspace:*",
    "read-excel-file": "catalog:",
    "use-intl": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@fivvi/database": "workspace:*",
    "@fivvi/testing": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-orm": "catalog:",
    "fflate": "catalog:",
    "pg": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

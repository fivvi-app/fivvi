// Biome plugin (E011, ADR-006, spec #145): the code of packages/api reaches business data only through
// the repositories and the tenant scope of @fivvi/database, never through a table or a raw database
// handle. Without a table or a handle a route cannot write a query that skips the tenant scope.
//
// Flags, in packages/api/src (biome.json registers it for that folder only, so the tests of the package,
// which seed and read rows directly, are not affected):
//   - a table of @fivvi/database or a raw database handle named in an import or a re-export;
//   - a namespace import, `export *`, `import()` or `require()` of @fivvi/database, which would hide the names;
//   - the modules that give a handle or a query builder: drizzle-orm, pg, and @fivvi/database/seed, /migrate
//     and /testing.
// A table or a handle that this list does not name must be added to it: test/repository-only-imports.test.ts
// fails when @fivvi/database exports a table the list does not name. Tested by that file too.
language js

pattern database_module() { r".@fivvi/database." }

// Every table of @fivvi/database (the business tables, the organizations, the sign-in tables and the
// system data), and the raw handles: createDatabase and createDatabaseFromEnv make a connection,
// Database, DatabaseClient and DatabaseExecutor type one.
pattern table_or_handle() {
  r"(?:authUsers|authSessions|authIdentities|authVerifications|authRateLimits|organizations|systemGreetings|teamMembers|clients|createDatabase|createDatabaseFromEnv|Database|DatabaseClient|DatabaseExecutor)"
}

or {
  JsImportNamedClause(named_specifiers=$specifiers, source=$source) where {
    $source <: database_module(),
    $specifiers <: contains table_or_handle(),
    register_diagnostic(span=$specifiers, message="A route reaches business data through a repository of @fivvi/database and its tenant scope, never through a table or a database handle (E011). Add a repository function to packages/database instead.")
  },
  JsExportNamedFromClause(specifiers=$specifiers, source=$source) where {
    $source <: database_module(),
    $specifiers <: contains table_or_handle(),
    register_diagnostic(span=$specifiers, message="A route reaches business data through a repository of @fivvi/database and its tenant scope, never through a table or a database handle (E011). Add a repository function to packages/database instead.")
  },
  JsImportNamespaceClause(source=$source) where {
    $source <: database_module(),
    register_diagnostic(span=$source, message="Import the repositories of @fivvi/database by name: a namespace import would let a table or a database handle in unseen (E011).")
  },
  JsExportFromClause(source=$source) where {
    $source <: database_module(),
    register_diagnostic(span=$source, message="Re-export the repositories of @fivvi/database by name: `export *` would let a table or a database handle through (E011).")
  },
  `import($source)` where {
    $source <: database_module(),
    register_diagnostic(span=$source, message="Import the repositories of @fivvi/database statically and by name (E011).")
  },
  `require($source)` where {
    $source <: database_module(),
    register_diagnostic(span=$source, message="Import the repositories of @fivvi/database statically and by name (E011).")
  },
  JsModuleSource() as $source where {
    $source <: r".(?:drizzle-orm|pg|@fivvi/database/(?:seed|migrate|testing))(?:/.*)?.",
    register_diagnostic(span=$source, message="packages/api has no database handle or query builder: business data goes through the repositories of @fivvi/database (E011).")
  }
}

{
  "$description": "Semantic colours, dark mode. Overrides color.light.json: every semantic colour needs a dark value here, and nothing else may be in this file.",
  "color": {
    "bg": {
      "$type": "color",
      "canvas": {
        "$value": "{color.base.black}"
      },
      "surface": {
        "$value": "{color.base.gray.900}"
      },
      "raised": {
        "$value": "{color.base.gray.800}"
      },
      "subtle": {
        "$value": "{color.base.gray.800}"
      },
      "inverse": {
        "$value": "{color.base.gray.100}"
      }
    },
    "text": {
      "$type": "color",
      "primary": {
        "$value": "{color.base.white}"
      },
      "secondary": {
        "$value": "{color.base.gray.400}"
      },
      "inverse": {
        "$value": "{color.base.black}"
      },
      "link": {
        "$value": "{color.accent.text}"
      }
    },
    "border": {
      "$type": "color",
      "default": {
        "$value": {
          "mix": {
            "color": "{color.base.gray.650}",
            "with": "{color.bg.surface}",
            "amount": 60,
            "space": "srgb"
          }
        }
      },
      "control": {
        "$value": "{color.base.gray.500}"
      },
      "focus": {
        "$value": "{color.accent.text}"
      }
    },
    "fill": {
      "$type": "color",
      "decorative": {
        "$value": {
          "mix": {
            "color": "{color.base.gray.75}",
            "with": "{color.bg.surface}",
            "amount": 30,
            "space": "srgb"
          }
        }
      }
    },
    "accent": {
      "$type": "color",
      "fill": {
        "$value": "{color.base.accent.fill}"
      },
      "on": {
        "$value": "{color.base.white}"
      },
      "text": {
        "$value": "{color.base.accent.text-dark}"
      },
      "gradient-top": {
        "$value": {
          "mix": {
            "color": "{color.accent.fill}",
            "with": "{color.base.black}",
            "amount": 85,
            "space": "oklab"
          }
        }
      },
      "gradient-bottom": {
        "$value": {
          "mix": {
            "color": "{color.accent.fill}",
            "with": "{color.base.black}",
            "amount": 75,
            "space": "oklab"
          }
        }
      }
    },
    "action": {
      "$type": "color",
      "primary": {
        "bg": {
          "$value": "{color.accent.fill}"
        },
        "bg-pressed": {
          "$value": "{color.accent.gradient-top}"
        },
        "fg": {
          "$value": "{color.accent.on}"
        }
      },
      "tonal": {
        "bg": {
          "$value": {
            "mix": {
              "color": "{color.base.gray.550}",
              "with": "{color.bg.surface}",
              "amount": 20,
              "space": "srgb"
            }
          }
        },
        "fg": {
          "$value": "{color.text.primary}"
        }
      },
      "danger": {
        "bg": {
          "$value": {
            "mix": {
              "color": "{color.base.red}",
              "with": "{color.base.black}",
              "amount": 85,
              "space": "srgb"
            }
          }
        },
        "fg": {
          "$value": "{color.base.white}"
        }
      }
    },
    "session": {
      "$type": "color",

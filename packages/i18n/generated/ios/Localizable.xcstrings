    "sessions.form.notes.repeatedTime" : {
      "comment" : "Shown when the chosen time happens twice because the clocks go back at the end of summer time (e.g. 02:30 on 25 October 2026). The first one, in summer time, is used. {date} is a full date, {time} a 24-hour time.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On %1$@, %2$@ happens twice. We'll use the first one (summer time)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op %1$@ komt %2$@ twee keer voor. We gebruiken de eerste keer (zomertijd)."
          }
        }
      }
    },

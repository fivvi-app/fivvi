{
  "sourceLanguage" : "nl",
  "strings" : {
    "app.title" : {
      "comment" : "Browser tab title (HTML <title>) of web pages that don't set their own. The product name, the same in both languages.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trainer Hub"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trainer Hub"
          }
        }
      }
    },
    "hello.description" : {
      "comment" : "Line under the title of the hello page, above the first-name field.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter your first name and we'll greet you."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vul je voornaam in, dan begroeten we je."
          }
        }
      }
    },
    "hello.firstNameLabel" : {
      "comment" : "Label of the first-name field on the hello page.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First name"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voornaam"
          }
        }
      }
    },
    "hello.greet" : {
      "comment" : "Button on the hello page that shows hello.greeting with the first name entered.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greet me"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begroet me"
          }
        }
      }
    },
    "hello.greeting" : {
      "comment" : "Greeting above the home screen. {name} is the user's first name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi %1$@,"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoi %1$@,"
          }
        }
      }
    },
    "hello.nextSession" : {
      "comment" : "{date} is a weekday and date without year, e.g. 'dinsdag 22 september'. {time} is a 24-hour time, e.g. '18:00'. Both are formatted in code in the workspace time zone.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your next session is on %1$@ at %2$@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je volgende sessie is op %1$@ om %2$@."
          }
        }
      }
    },
    "hello.noSessionsToday" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have no sessions today."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt vandaag geen sessies."
          }
        }
      }
    },
    "hello.sessionsToday" : {
      "comment" : "Number of sessions the trainer has today, 1 or more. For 0, use hello.noSessionsToday.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "You have %arg session today."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "You have %arg sessions today."
                    }
                  }
                }
              }
            }
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Je hebt vandaag %arg sessie."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Je hebt vandaag %arg sessies."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "hello.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome to Trainer Hub"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welkom bij Trainer Hub"
          }
        }
      }
    },
    "notFound.body" : {

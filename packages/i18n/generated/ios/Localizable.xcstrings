    },
    "team.removeDialog.body" : {
      "comment" : "Body of the remove dialog. {name} is the person's name, repeated instead of a pronoun; {word} the workspace's word for a Trainer (F068), singular, lowercase, e.g. instructeur / instructor; {workspace} the workspace name. Says that only the team access goes and what they have as a client stays.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ loses the %2$@ role at %3$@. What %1$@ has as a client, such as bookings, stays."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ verliest de rol van %2$@ bij %3$@. Wat %1$@ als klant heeft, zoals boekingen, blijft."
          }
        }
      }
    },
    "team.removeDialog.cancel" : {

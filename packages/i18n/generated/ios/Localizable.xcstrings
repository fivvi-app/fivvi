    "noAccess.body" : {
      "comment" : "Text of the no-access page (information-architecture §9.5, No permission). Native apps show it too, under the same conditions. The Dutch uses 'werkruimte' as the spec words it.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You don't have access to a workspace yet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt nog geen toegang tot een werkruimte."
          }
        }
      }
    },
    "noAccess.title" : {
      "comment" : "Heading of the no-access page: a signed-in person who is not in a workspace and may not create one (a client, or someone who was removed). The page has the sign-out button.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No access yet"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog geen toegang"
          }
        }
      }
    },
    "noPermission.body" : {
      "comment" : "Text of the no-permission page. {workspace} is the name of the workspace, a name as typed by its owner and not translated.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You don't have access to this page. Ask the owner of %1$@."

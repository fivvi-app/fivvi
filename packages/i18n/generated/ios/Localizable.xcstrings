    "team.invite.title" : {
      "comment" : "Title of the invite dialog of the Trainers page (TW-06), an invitation to become a Trainer of the workspace. {aWord} is the workspace's word with its article, lowercase (F068), e.g. een instructeur / an instructor. Dutch 'Nodig {aWord} uit' breaks GLOSSARY §5.1's object-first order ('{AWord} uitnodigen') because parity forces it: '{AWord} uitnodigen' would need 'Invite {AWord}' in English, which would put a capitalised word after the verb in English.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invite %1$@"

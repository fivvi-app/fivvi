{
  "sourceLanguage" : "nl",
  "strings" : {
    "app.name" : {
      "comment" : "Name of the native app under its home-screen icon (iOS CFBundleDisplayName and CFBundleName, Android app label). The name of the trainer app, Fivvi Pro, the same in both languages.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fivvi Pro"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fivvi Pro"
          }
        }
      }
    },
    "app.title" : {
      "comment" : "Browser tab title (HTML <title>) of web pages that don't set their own. The product name, Fivvi, the same in both languages.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fivvi"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fivvi"
          }
        }
      }
    },
    "common.loading" : {
      "comment" : "Accessibility label of the progress indicator while a screen loads (read by VoiceOver and TalkBack).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loading…"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laden…"
          }
        }
      }
    },
    "common.retry" : {
      "comment" : "Button under an error message that tries the failed action again.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try again"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opnieuw proberen"
          }
        }
      }
    },
    "hello.continue" : {
      "comment" : "Submit button of the first-name form on the hello page. Shows hello.formGreeting with the name entered.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doorgaan"
          }
        }
      }
    },
    "hello.description" : {
      "comment" : "Line under the title of the hello page, above the first-name field.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter your first name and we'll greet you."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vul je voornaam in, dan begroeten we je."
          }
        }
      }
    },
    "hello.error" : {
      "comment" : "Shown on the native hello screen when the greeting can't be loaded (no connection, or an unknown greeting). Above the common.retry button.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We couldn't load the greeting. Try again."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We konden de begroeting niet laden. Probeer het opnieuw."
          }
        }
      }
    },
    "hello.firstNameLabel" : {
      "comment" : "Label of the first-name field on the hello page.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First name"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voornaam"
          }
        }
      }
    },
    "hello.formGreeting" : {
      "comment" : "Shown on the hello page after the first-name form is sent. {name} is the first name entered.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi %1$@, nice to have you here."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoi %1$@, fijn dat je er bent."
          }
        }
      }
    },
    "hello.greeting" : {
      "comment" : "Greeting above the home screen. {name} is the user's first name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi %1$@,"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoi %1$@,"
          }
        }
      }
    },
    "hello.nextSession" : {
      "comment" : "{date} is a weekday and date without year, e.g. 'dinsdag 22 september'. {time} is a 24-hour time, e.g. '18:00'. Both are formatted in code in the workspace time zone.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your next session is on %1$@ at %2$@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je volgende sessie is op %1$@ om %2$@."
          }
        }
      }
    },
    "hello.noSessionsToday" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have no sessions today."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt vandaag geen sessies."
          }
        }
      }
    },
    "hello.sessionsToday" : {
      "comment" : "Number of sessions the trainer has today, 1 or more. For 0, use hello.noSessionsToday.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "You have %arg session today."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "You have %arg sessions today."
                    }
                  }
                }
              }
            }
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Je hebt vandaag %arg sessie."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Je hebt vandaag %arg sessies."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "hello.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome to Fivvi"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welkom bij Fivvi"
          }
        }
      }
    },
    "home.openWeb" : {
      "comment" : "Button under home.setUpOnWeb in the native apps; opens Fivvi on the web (the first-run screen) in the phone's browser.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Fivvi in the browser"

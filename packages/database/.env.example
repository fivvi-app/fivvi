# Local Postgres from the repo's compose.yaml (`pnpm db:up`). Copy this file to `.env`.
# Local development only; preview and production get their values from Railway (ADR-011).

# The privileged connection: the user that owns the tables. Only the migrations (`pnpm db:migrate`),
# the seed (`pnpm db:seed`) and the daily cron job use it, through `openPrivilegedDatabase`.
DATABASE_URL=postgres://fivvi:fivvi@localhost:5432/fivvi

# The app role `fivvi_app` (E011): what the web server connects as, so RLS applies to it.
# `pnpm db:migrate` gives the role a login with this password (16 characters or more, printable
# ASCII); APP_DATABASE_URL must use the same password. Local values only, never a real secret.
# The role is shared by every worktree and by the tests on this one local Postgres, so keep
# this password as it is: it is the one the test setup gives the role (packages/testing).
APP_DATABASE_PASSWORD=fake-app-role-password-for-tests
APP_DATABASE_URL=postgres://fivvi_app:fake-app-role-password-for-tests@localhost:5432/fivvi

# Server the integration tests create their throwaway databases on (needs CREATEDB).
# Falls back to DATABASE_URL. Must point at localhost; never at a Railway database.
# TEST_DATABASE_URL=postgres://fivvi:fivvi@localhost:5432/fivvi

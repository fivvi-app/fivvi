{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // Sources run directly on Node's type stripping (no build step), so relative
    // imports carry their `.ts` extension and only erasable syntax is allowed.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src", "test", "*.ts"],
  "exclude": ["node_modules"]
}

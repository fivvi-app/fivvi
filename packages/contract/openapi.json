{
  "openapi": "3.1.0",
  "info": {
    "title": "Fivvi API",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthCheckStatus"
          },
          "checks": {
            "type": "object",
            "properties": {
              "database": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/HealthCheckStatus"
                  },
                  {
                    "description": "Postgres answered a ping."
                  }
                ]
              }
            },
            "required": [
              "database"
            ]
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "description": "Liveness of the API and its dependencies. Contains no error details."
      },
      "HealthCheckStatus": {
        "type": "string",
        "enum": [
          "ok",
          "unavailable"
        ],
        "description": "`ok` only when every check is `ok`."
      },
      "HelloResponse": {
        "type": "object",
        "properties": {
          "greetingKey": {
            "type": "string",
            "description": "i18n message key that the client renders in `locale`.",
            "example": "hello.title"
          },
          "locale": {
            "$ref": "#/components/schemas/Locale"
          }
        },
        "required": [
          "greetingKey",
          "locale"
        ]
      },
      "Locale": {
        "type": "string",
        "enum": [
          "nl-NL",
          "en"
        ],
        "description": "Catalog locale from packages/i18n: Dutch (nl-NL) or English (en)."
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "validation_failed"
            ]
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "description": "Dot-separated path of the invalid field."
                },
                "code": {
                  "type": "string",
                  "description": "Machine-readable issue code."
                }
              },
              "required": [
                "path",
                "code"
              ]
            }
          }
        },
        "required": [
          "code",
          "issues"
        ],
        "description": "The request did not match the contract. Contains no user-facing text."
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "The account ID."
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "The address the account signs in with."
          },
          "preferredLocale": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "nl-NL",
              "en",
              null
            ],
            "description": "The language stored on the account; null until one is stored."
          }
        },
        "required": [
          "id",
          "email",
          "preferredLocale"
        ],
        "description": "The signed-in account."
      },
      "Unauthorized": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "unauthorized"
            ]
          }
        },
        "required": [
          "code"
        ],
        "description": "The request has no valid sign-in session. Contains no user-facing text."
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "getHealth",
        "tags": [
          "health"
        ],
        "summary": "Health check",
        "description": "Pings the database. Railway uses it as the deploy health check, so a deployment that can't reach Postgres never receives traffic.",
        "responses": {
          "200": {
            "description": "The API and all its dependencies are healthy.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "A dependency is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/hello": {
      "get": {
        "operationId": "getHello",
        "tags": [
          "hello"
        ],
        "summary": "Greeting for the walking skeleton",
        "description": "The `hello` greeting from the database. Without `locale`, the locale is the first supported language in the Accept-Language header, otherwise en.",
        "parameters": [
          {
            "schema": {
              "$ref": "#/components/schemas/Locale"
            },
            "required": false,
            "description": "Catalog locale from packages/i18n: Dutch (nl-NL) or English (en).",
            "name": "locale",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "The greeting key and the locale to render it in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HelloResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameters.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error, reported to error tracking. Contains no error details.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "Internal Server Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "operationId": "getMe",
        "tags": [
          "me"
        ],
        "summary": "The signed-in account",
        "description": "The account of the sign-in session in the request. The web sends the sign-in session cookie; there is no other way to sign in yet.",
        "responses": {
          "200": {
            "description": "The account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "No valid sign-in session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Unauthorized"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error, reported to error tracking. Contains no error details.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "Internal Server Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}

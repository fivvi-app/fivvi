{
  "openapi": "3.1.0",
  "info": {
    "title": "Fivvi API",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token",
        "description": "The sign-in session cookie of the web (`__Secure-` prefixed over https). Set by the web’s own sign-in, not by this contract."
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "The token of `POST /v1/sign-in/token`: a sign-in session. Ended by `POST /v1/sign-out`."
      }
    },
    "schemas": {
      "NotSignedIn": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "not_signed_in"
            ]
          }
        },
        "required": [
          "code"
        ],
        "description": "The request has no valid sign-in session. Contains no user-facing text."
      },
      "NotFound": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "not_found"
            ]
          }
        },
        "required": [
          "code"
        ],
        "description": "The workspace or record does not exist or is out of the caller’s reach; the answer is the same for both. Contains no user-facing text."
      },
      "Forbidden": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "forbidden"
            ]
          }
        },
        "required": [
          "code"
        ],
        "description": "The caller has a place in the workspace, but not the access this route needs. Contains no user-facing text."
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthCheckStatus"
          },
          "checks": {
            "type": "object",
            "properties": {
              "database": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/HealthCheckStatus"
                  },
                  {
                    "description": "Postgres answered a ping."
                  }
                ]
              }
            },
            "required": [
              "database"
            ]
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "description": "Liveness of the API and its dependencies. Contains no error details."
      },
      "HealthCheckStatus": {
        "type": "string",
        "enum": [
          "ok",
          "unavailable"
        ],
        "description": "`ok` only when every check is `ok`."
      },
      "HelloResponse": {
        "type": "object",
        "properties": {
          "greetingKey": {
            "type": "string",
            "description": "i18n message key that the client renders in `locale`.",
            "example": "hello.title"
          },
          "locale": {
            "$ref": "#/components/schemas/Locale"
          }
        },
        "required": [
          "greetingKey",
          "locale"
        ]
      },
      "Locale": {
        "type": "string",
        "enum": [
          "nl-NL",
          "en"
        ],
        "description": "Catalog locale from packages/i18n: Dutch (nl-NL) or English (en)."
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "validation_failed"
            ]
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "description": "Dot-separated path of the invalid field."
                },
                "code": {
                  "type": "string",
                  "description": "Machine-readable issue code."
                }
              },
              "required": [
                "path",
                "code"
              ]
            }
          }
        },
        "required": [
          "code",
          "issues"
        ],
        "description": "The request did not match the contract. Contains no user-facing text."
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "The account ID."
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "The address the account signs in with."
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "The person’s own name; null until one is given (TW-11 asks for it)."
          },
          "preferredLocale": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "nl-NL",
              "en",
              null
            ],
            "description": "The language stored on the account; null until one is stored."
          },
          "canCreateWorkspace": {
            "type": "boolean",
            "description": "Whether the account may set up a workspace: it is on the sign-up allowlist and has no team role in any workspace yet. The web and the apps show the first-run screen or the no-access page from this, never from rules of their own."
          },
          "workspaces": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MeWorkspace"
            },
            "description": "The workspaces the account has a team role in, by name. Empty when it has none. Workspaces it is only a client of are not listed."
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "preferredLocale",
          "canCreateWorkspace",
          "workspaces"
        ],
        "description": "The signed-in account."
      },
      "MeWorkspace": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "The workspace ID."
          },
          "name": {
            "type": "string",
            "description": "The name shown in the product."
          },
          "slug": {
            "type": "string",
            "description": "The URL name: `/w/{slug}` on the web."
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "trainer"
            ],
            "description": "What the account is in the workspace. The web shows Settings to the Owner only; the API refuses the rest of what a Trainer may not do with `403` anyway."
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "role"
        ],
        "description": "A workspace the account has a team role in."
      },
      "UpdateMeRequest": {
        "type": "object",
        "properties": {
          "preferredLocale": {
            "type": "string",
            "enum": [
              "nl-NL",
              "en"
            ],
            "description": "The language to store on the account, for its screens and emails: `nl-NL` or `en`. Any other value, a browser’s `nl-BE` included, is refused with `400`."
          }
        },
        "description": "What to change on the signed-in account. Fields left out stay as they are."
      },
      "SignInRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "The address the account signs in with."
          },
          "locale": {
            "$ref": "#/components/schemas/Locale"
          }
        },
        "required": [
          "email",
          "locale"
        ],
        "description": "Asks for the sign-in email. `locale` is the interface language the app resolved; the email follows ADR-019."
      },
      "SignInTokenResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "The bearer token: a sign-in session, valid 30 days after its last use and renewed on use. Send it as `Authorization: Bearer <token>`."
          }
        },
        "required": [
          "token"
        ]
      },
      "Unauthorized": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "unauthorized"
            ]
          }
        },
        "required": [
          "code"
        ],
        "description": "The request has no valid sign-in session. Contains no user-facing text."
      },
      "SignInTokenRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "The address the account signs in with."
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "description": "The 6-digit code in the email."
          }
        },
        "required": [
          "email",
          "code"
        ]
      },
      "Workspace": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "The workspace ID."
          },
          "name": {
            "type": "string",
            "description": "The name shown in the product."
          },
          "slug": {
            "type": "string",
            "description": "The URL name, made from the name when the workspace is created and never changed by a rename. Lower case letters, digits and hyphens."
          },
          "defaultLocale": {
            "$ref": "#/components/schemas/Locale"
          },
          "timeZone": {
            "type": "string",
            "description": "The IANA time zone dates and times are shown in, for example `Europe/Amsterdam`."
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "defaultLocale",
          "timeZone"
        ],
        "description": "A workspace: a gym or an independent trainer’s business."
      },
      "CreateWorkspaceRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "The name of the gym or business, as shown in the product."
          },
          "personName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "The creator’s own name, stored on the account. Leave it out when the account has one."
          }
        },
        "required": [
          "name"
        ],
        "description": "Creates a workspace for the caller, who becomes its Owner. Nothing else is asked: the default language, the time zone and the slug are the platform’s defaults."
      },
      "RenameWorkspaceRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "The new name, as the product shows it from now on."
          }
        },
        "required": [
          "name"
        ],
        "description": "Renames a workspace. Only the name changes: the slug stays, so links keep working."
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "getHealth",
        "tags": [
          "health"
        ],
        "summary": "Health check",
        "description": "Pings the database. Railway uses it as the deploy health check, so a deployment that can't reach Postgres never receives traffic.",
        "x-access": {
          "type": "public"
        },
        "responses": {
          "200": {
            "description": "The API and all its dependencies are healthy.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "A dependency is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/hello": {
      "get": {
        "operationId": "getHello",
        "tags": [
          "hello"
        ],
        "summary": "Greeting for the walking skeleton",
        "description": "The `hello` greeting from the database. Without `locale`, the locale is the first supported language in the Accept-Language header, otherwise en.",
        "x-access": {
          "type": "public"
        },
        "parameters": [
          {
            "schema": {
              "$ref": "#/components/schemas/Locale"
            },
            "required": false,
            "description": "Catalog locale from packages/i18n: Dutch (nl-NL) or English (en).",
            "name": "locale",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "The greeting key and the locale to render it in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HelloResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameters.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error, reported to error tracking. Contains no error details.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "Internal Server Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "operationId": "getMe",
        "tags": [
          "me"
        ],
        "summary": "The signed-in account",
        "description": "The account of the sign-in session in the request. The web sends the sign-in session cookie, the apps’ `Authorization: Bearer <token>` (the token of `POST /v1/sign-in/token`). A request with an `Authorization` header is judged by that token alone, never by a cookie. It also tells where the person goes after sign-in: the workspaces they have a team role in, and whether they may set one up (`canCreateWorkspace`).",
        "security": [
          {
            "cookieAuth": []
          },
          {
            "bearerAuth": []
          }
        ],
        "x-access": {
          "type": "account",
          "workspaces": "team"
        },
        "responses": {
          "200": {
            "description": "The account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Nobody is signed in: no valid sign-in session or bearer token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotSignedIn"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error, reported to error tracking. Contains no error details.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "Internal Server Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateMe",
        "tags": [
          "me"
        ],
        "summary": "Change the signed-in account",
        "description": "Stores the language the person chose (`preferredLocale`), so every browser and app of the account shows it from its next load. Answers with the account, as `GET /v1/me` does. A value other than `nl-NL` or `en` answers `400` and nothing changes.",
        "security": [
          {
            "cookieAuth": []
          },
          {
            "bearerAuth": []
          }
        ],
        "x-access": {
          "type": "account",
          "workspaces": "team"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The account with its change.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "400": {
            "description": "The request did not match the contract.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Nobody is signed in: no valid sign-in session or bearer token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotSignedIn"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error, reported to error tracking. Contains no error details.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "Internal Server Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sign-in/request": {
      "post": {
        "operationId": "requestSignIn",
        "tags": [
          "sign-in"
        ],
        "summary": "Ask for a sign-in email",
        "description": "Sends the sign-in email (EM-08, a link and a 6-digit code) to an account or an allowed address. The answer is the same for every address and for a request over the rate limits, so it never says who has an account.",
        "x-access": {
          "type": "public"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted. The body is empty."
          },
          "400": {
            "description": "The request did not match the contract.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error, reported to error tracking. Contains no error details.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "Internal Server Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sign-in/token": {
      "post": {
        "operationId": "exchangeSignInCode",
        "tags": [
          "sign-in"
        ],
        "summary": "Exchange the emailed code for a bearer token",
        "description": "Uses up the verification of the email (the web’s link and code are the same one), creates the account at the first sign-in of an allowed address, and returns a bearer token. It sets no cookie. Every failure gets the same 401.",
        "x-access": {
          "type": "public"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInTokenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The bearer token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignInTokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "The request did not match the contract.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "401": {
            "description": "The code was not accepted. Nothing says why: it can be wrong, used, replaced, expired or out of attempts, or this network asked too often.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Unauthorized"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error, reported to error tracking. Contains no error details.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "Internal Server Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sign-out": {
      "post": {
        "operationId": "signOut",
        "tags": [
          "sign-in"
        ],
        "summary": "Sign out",
        "description": "Ends the sign-in session of the bearer token in the request, and only that one. Other phones and browsers of the account stay signed in.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-access": {
          "type": "public"
        },
        "responses": {
          "204": {
            "description": "The sign-in session has ended. The body is empty."
          },
          "401": {
            "description": "No valid bearer token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Unauthorized"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error, reported to error tracking. Contains no error details.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "Internal Server Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/workspaces": {
      "post": {
        "operationId": "createWorkspace",
        "tags": [
          "workspaces"
        ],
        "summary": "Create the caller’s workspace",
        "description": "Creates a workspace and makes the caller its Owner, in one transaction: the workspace (Dutch as its default language, `Europe/Amsterdam`, a slug made from its name, with a number added when taken), the Owner’s team role and, when given, the account’s name. Only an account on the sign-up allowlist with no team role in any workspace may: anyone else gets `403` and nothing is created.",
        "security": [
          {
            "cookieAuth": []
          },
          {
            "bearerAuth": []
          }
        ],
        "x-access": {
          "type": "account",
          "workspaces": "team"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWorkspaceRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The new workspace.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          },
          "400": {
            "description": "The request did not match the contract.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Nobody is signed in: no valid sign-in session or bearer token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotSignedIn"
                }
              }
            }
          },
          "403": {
            "description": "The account may not create a workspace: it is not on the sign-up allowlist, or it already has a team role in a workspace.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Forbidden"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error, reported to error tracking. Contains no error details.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "Internal Server Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/workspaces/{workspaceId}": {
      "get": {
        "operationId": "getWorkspace",
        "tags": [
          "workspaces"
        ],
        "summary": "A workspace",
        "description": "The workspace: its name, URL name, default language and time zone.",
        "security": [
          {
            "cookieAuth": []
          },
          {
            "bearerAuth": []
          }
        ],
        "x-access": {
          "type": "workspace",
          "roles": [
            "owner",
            "trainer"
          ],
          "client": "none"
        },
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "The workspace ID."
            },
            "required": true,
            "description": "The workspace ID.",
            "name": "workspaceId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The workspace.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          },
          "400": {
            "description": "The request did not match the contract.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Nobody is signed in: no valid sign-in session or bearer token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotSignedIn"
                }
              }
            }
          },
          "403": {
            "description": "The caller has a place in the workspace that this route’s access doesn’t allow.",
            "content": {
              "application/json": {
                "schema": {

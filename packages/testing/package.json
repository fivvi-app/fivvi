{
  "name": "@trainer-hub/testing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./clock": "./src/clock.ts",
    "./database": "./src/database.ts",
    "./database/setup": "./src/database-setup.ts",
    "./vitest": "./src/vitest.ts"
  },
  "scripts": {

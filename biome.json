{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/*.md",
      "!**/next-env.d.ts",
      "!**/migrations",
      "!packages/contract/openapi.json",
      "!packages/contract/src/generated",
      "!packages/design-tokens/generated"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "next": "recommended",
      "react": "recommended",
      "test": "recommended"
    },
    "rules": {
      "recommended": true,
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      },
      "suspicious": {
        "useAwait": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@sentry/**"],
                "message": "Report errors through @fivvi/observability, which scrubs personal data (E009)."
              },
              {
                "group": ["posthog-node", "posthog-node/**"],
                "message": "Send product events with track() from @fivvi/observability, which only accepts catalog events (E009)."
              },
              {
                "group": ["posthog-js", "posthog-js/**"],
                "message": "Capture page views through @fivvi/observability/page-views, which is cookieless and sends the path only (E009)."
              },
              {
                "group": ["better-auth", "better-auth/**", "@better-auth/**"],
                "message": "Only packages/auth imports Better Auth; use its interface (ADR-007, F001)."
              }
            ]
          }
        },
        "useImportType": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/observability/**"],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    },
    {
      "includes": ["packages/auth/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@sentry/**"],
                    "message": "Report errors through @fivvi/observability, which scrubs personal data (E009)."
                  },
                  {
                    "group": ["posthog-node", "posthog-node/**"],
                    "message": "Send product events with track() from @fivvi/observability, which only accepts catalog events (E009)."
                  },
                  {
                    "group": ["posthog-js", "posthog-js/**"],
                    "message": "Capture page views through @fivvi/observability/page-views, which is cookieless and sends the path only (E009)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}

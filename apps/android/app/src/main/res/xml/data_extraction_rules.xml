<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device-to-device transfer on Android 12 and up (android:dataExtractionRules). The session store holds the
     sign-in token, encrypted with a Keystore key that never leaves the device, so it stays out of both (F001, AC11). The
     day that Vandaag keeps for its offline view holds client names, so it stays out of both too (F013, AC7). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="session/" />
        <exclude domain="file" path="personal/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="session/" />
        <exclude domain="file" path="personal/" />
    </device-transfer>
</data-extraction-rules>

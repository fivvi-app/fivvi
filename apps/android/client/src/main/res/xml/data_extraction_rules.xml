<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device-to-device transfer on Android 12 and up (android:dataExtractionRules). The session store holds the
     sign-in token, encrypted with a Keystore key that never leaves the device, so it stays out of both (F001, AC11). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="session/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="session/" />
    </device-transfer>
</data-extraction-rules>

{
  "name": "@fivvi/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/publish-source-maps.ts && node scripts/copy-static.ts",
    "start": "node .next/standalone/apps/web/server.js",
    "lint": "biome check --formatter-enabled=false --error-on-warnings .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "format:check": "biome format .",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fivvi/api": "workspace:*",
    "@fivvi/auth": "workspace:*",
    "@fivvi/contract": "workspace:*",
    "@fivvi/database": "workspace:*",
    "@fivvi/email": "workspace:*",
    "@fivvi/i18n": "workspace:*",
    "@fivvi/observability": "workspace:*",
    "@fivvi/ui": "workspace:*",
    "next": "catalog:",
    "next-intl": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@biomejs/biome": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@fivvi/design-tokens": "workspace:*",
    "@fivvi/testing": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "drizzle-orm": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

# For `pnpm dev` (next dev reads this folder's .env). Copy this file to `.env`.
# Local development only; Railway sets the real values (docs/engineering/ENVIRONMENTS.md §7).

# The web connects to Postgres as the app role `fivvi_app` (E011), never as the privileged user
# of DATABASE_URL, and refuses to start with a role that bypasses RLS. Run `pnpm db:migrate`
# first: it gives the role this password (APP_DATABASE_PASSWORD in packages/database/.env).
APP_DATABASE_URL=postgres://fivvi_app:fake-local-app-role-password@localhost:5432/trainer_hub

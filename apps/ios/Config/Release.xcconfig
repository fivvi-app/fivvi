// Release: the production API over HTTPS, on the custom domain (docs/engineering/ENVIRONMENTS.md, "Production address";
// the Railway domain still answers, so builds installed before the switch keep working). Info.plist has no App Transport
// Security exception, and declares that the app uses no non-exempt encryption (HTTPS through the OS only, E017 AC1).
// `pnpm test:ios` fails on an empty, plain-HTTP or `.invalid` address. `//` starts a comment in an xcconfig, hence `$()`.
#include "Simulator.xcconfig"
INFOPLIST_FILE = Config/Info.plist
FIVVI_API_BASE_URL = https:/$()/fivvi.app/api

// The version of both apps and the default build number (E017 AC4): apps/Version.xcconfig. A release run overrides
// the build number with `xcodebuild CURRENT_PROJECT_VERSION=<n>`.
#include "../../Version.xcconfig"

// Error reporting (E009, docs/engineering/OBSERVABILITY.md §1 "iOS") to the Sentry `ios` project. A DSN can only send
// events and ships inside the app, so it isn't a secret (#85). EU region: `pnpm test:ios` fails unless it is
// `https:/$()/<key>@<org>.ingest.de.sentry.io/<project>`.
FIVVI_SENTRY_DSN = https:/$()/3d12695a1d4aaf5878e911e39b072238@o4512131315531776.ingest.de.sentry.io/4512266384113744
FIVVI_SENTRY_ENVIRONMENT = production

// The App Store provisioning profile of a release run, for this target alone (E017). The run passes its name as
// `xcodebuild FIVVI_RELEASE_PROFILE=<name>` (scripts/release-ios.sh). Setting PROVISIONING_PROFILE_SPECIFIER on the command
// line instead would reach every target, and the resource bundles of the local Swift packages refuse a profile. Empty
// for every other Release build, which then signs as before.
PROVISIONING_PROFILE_SPECIFIER = $(FIVVI_RELEASE_PROFILE)

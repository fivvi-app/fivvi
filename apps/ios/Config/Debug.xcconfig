// Debug: the local dev server (`pnpm dev`, port 3000), which the iOS simulator reaches as localhost. Plain HTTP is
// allowed only in this configuration (Info-Debug.plist). `//` starts a comment in an xcconfig, hence `$()`.
// The token store needs Keychain access, which a simulator build gets from its entitlements. A build without signing
// (CODE_SIGNING_ALLOWED=NO, as `pnpm test:ios` and CI build) embeds none, and the Keychain answers errSecMissingEntitlement
// (-34018), so the simulator build carries the access group in its own Mach-O section, which is where Xcode puts a
// simulator build's entitlements. A device build is signed and gets its Keychain access group from its signature.
OTHER_LDFLAGS[sdk=iphonesimulator*] = $(inherited) -Wl,-sectcreate,__TEXT,__entitlements,$(SRCROOT)/Config/Simulator.entitlements
// The Mach-O section above has to be in the executable, not in a debug dylib the executable loads.
ENABLE_DEBUG_DYLIB = NO
INFOPLIST_FILE = Config/Info-Debug.plist
FIVVI_API_BASE_URL = http:/$()/localhost:3000/api

// Error reporting (E009, docs/engineering/OBSERVABILITY.md §1 "iOS"): off without a DSN, so Debug builds, tests and CI
// send nothing. For the manual ingestion check, set FIVVI_SENTRY_DSN in Config/Local.xcconfig.
FIVVI_SENTRY_DSN =
FIVVI_SENTRY_ENVIRONMENT = development

// The version of both apps and the build number of Debug builds and CI (1): apps/Version.xcconfig (E017 AC4).
#include "../../Version.xcconfig"

// For a preview environment or a phone on your LAN, set FIVVI_API_BASE_URL in Config/Local.xcconfig (git-ignored).
#include? "Local.xcconfig"

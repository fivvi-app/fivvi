// Debug: the local dev server (`pnpm dev`, port 3000), which the iOS simulator reaches as localhost. Plain HTTP is
// allowed only in this configuration (Info-Debug.plist). `//` starts a comment in an xcconfig, hence `$()`.
INFOPLIST_FILE = Config/Info-Debug.plist
FIVVI_API_BASE_URL = http:/$()/localhost:3000/api

// Error reporting (E009, docs/engineering/OBSERVABILITY.md §1 "iOS"): off without a DSN, so Debug builds, tests and CI
// send nothing. For the manual ingestion check, set FIVVI_SENTRY_DSN in Config/Local.xcconfig.
FIVVI_SENTRY_DSN =
FIVVI_SENTRY_ENVIRONMENT = development

// For a preview environment or a phone on your LAN, set FIVVI_API_BASE_URL in Config/Local.xcconfig (git-ignored).
#include? "Local.xcconfig"

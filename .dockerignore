# Keep the build context small and free of secrets and local state.
.git
.worktrees
.tools
.claude
.railway
# The website renders docs/legal when it is built (F064, AC10); the rest of docs stays out.
docs/*
!docs/legal
**/node_modules
**/.next
**/.turbo
**/.vitest
**/coverage
**/.build
**/.swiftpm
**/.env
**/.env.*
**/*.log
**/.DS_Store

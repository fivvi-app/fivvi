{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [".nvmrc", "tsconfig.base.json", "biome.json", ".gitignore"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build", "//#lint:root"]
    },
    "test": {
      "dependsOn": ["^build", "//#test:root"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["TEST_DATABASE_URL", "DATABASE_URL"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["CI", "E2E_PORT", "PLAYWRIGHT_BROWSERS_PATH"]
    },
    "check": {
      "dependsOn": ["^build"]
    },
    "format:check": {
      "dependsOn": ["//#format:check:root"]
    },
    "//#format:check:root": {},
    "//#lint:root": {
      "inputs": [".claude/**"]
    },
    "//#test:root": {
      "inputs": [".claude/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}

{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [
    ".nvmrc",
    "tsconfig.base.json",
    "eslint.config.js",
    ".prettierrc.json",
    ".prettierignore",
    ".gitignore"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "format:check": {
      "dependsOn": ["//#format:check:root"]
    },
    "//#format:check:root": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}

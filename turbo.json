{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [".nvmrc", "tsconfig.base.json", "biome.json", ".gitignore"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "typecheck"],
      "env": [
        "NEXT_PUBLIC_SENTRY_DSN",
        "RAILWAY_ENVIRONMENT_NAME",
        "RAILWAY_GIT_COMMIT_SHA",
        "SENTRY_AUTH_TOKEN"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build", "//#lint:root"]
    },
    "test": {
      "dependsOn": ["^build", "//#test:root"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/testing/src/**",
        "$TURBO_ROOT$/packages/database/migrations/**",
        "$TURBO_ROOT$/packages/database/src/seed.ts",
        "$TURBO_ROOT$/packages/database/src/scripts/**",
        "$TURBO_ROOT$/compose.yaml"
      ],
      "passThroughEnv": ["TEST_DATABASE_URL", "DATABASE_URL"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/testing/src/**",
        "$TURBO_ROOT$/packages/database/migrations/**",
        "$TURBO_ROOT$/packages/database/src/seed.ts",
        "$TURBO_ROOT$/packages/database/src/scripts/**",
        "$TURBO_ROOT$/compose.yaml"
      ],
      "passThroughEnv": [
        "CI",
        "E2E_PORT",
        "PLAYWRIGHT_BROWSERS_PATH",
        "TEST_DATABASE_URL",
        "DATABASE_URL"
      ]
    },
    "check": {
      "dependsOn": ["^build", "//#check:root", "//#check:quarantine"]
    },
    "format:check": {
      "dependsOn": ["//#format:check:root"]
    },
    "//#format:check:root": {},
    "//#lint:root": {
      "inputs": [".claude/**", "scripts/**", ".githooks/**", ".shellcheckrc"]
    },
    "//#test:root": {
      "inputs": [
        ".claude/**",
        ".agents/agents/**",
        ".github/agents/**",
        ".codex/**",
        "scripts/**",
        ".githooks/**",
        "quarantine/*.txt",
        "Dockerfile",
        "apps/*/package.json",
        "packages/*/package.json",
        "pnpm-workspace.yaml",
        "compose.yaml",
        ".github/rulesets/**",
        ".github/repo-settings.json",
        ".github/workflows/ci.yml",
        "e2e/maestro/**/*.yaml",
        "e2e/maestro/**/*.yml",
        "e2e/maestro/**/*.js",
        "apps/ios/**/*.swift",
        "apps/ios/**/*.xcconfig",
        "apps/ios/**/*.plist",
        "apps/ios/**/*.xctestplan",
        "apps/ios/**/*.yml",
        "apps/ios/.swiftlint.yml",
        "apps/ios/.gitignore",
        "apps/ios/Config/*.entitlements",
        "apps/ios/**/project.pbxproj",
        "apps/ios/FivviPro.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved",
        "apps/ios/FivviPro/Assets.xcassets/**",
        "apps/ios/README.md",
        "apps/android/README.md",
        "apps/android/app/src/main/res/**",
        "apps/android/app/src/main/ic_launcher-playstore.png",
        "apps/android/client/src/main/res/**",
        "apps/android/client/src/main/ic_launcher-playstore.png",
        "apps/android/**/*.gradle",
        "apps/android/**/*.kt",
        "apps/android/**/*.kts",
        "apps/android/**/*.properties",
        "apps/android/**/*.toml",
        "apps/android/**/*.xml",
        "apps/Version.xcconfig",
        "packages/design-tokens/src/**",
        "packages/design-tokens/tokens/**",
        "packages/design-tokens/generated/web/tokens.css",
        "packages/design-tokens/package.json",
        "packages/*/*/Package.swift"
      ]
    },
    "//#check:root": {
      "inputs": [
        ".agents/**",
        ".claude/agents/**",
        ".github/agents/**",
        ".codex/**",
        "scripts/skills.sh",
        "scripts/agents.sh",
        "scripts/_lib.sh"
      ]
    },
    "//#check:quarantine": {
      "cache": false,
      "inputs": ["quarantine/**", "scripts/quarantine.mjs"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
